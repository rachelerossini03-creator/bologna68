        <head rend="red bold uppercase" scope="major">
          <lb/><rs type="social_group">STUDENTI</rs>
        </head>

        <p rend="red bold uppercase">
          <lb/>NON VOGLIAMO PIU' VIVERE
          <lb/>LOTTANDO L'UNO CONTRO
          <lb/>L'ALTRO, PER AVERE UN POSTO
          <lb/>MIGLIORE, MA SEMPRE DI SERVO
          <lb/>LA LOTTA E' RIPRESA
          <lb/>ATTACCANDO TUTTI GLI STRUMENTI
          <lb/>DI <term type="political_concept">SELEZIONE</term> E <term type="political_concept">REPRESSIONE</term>,
          <lb/>ATTACCANDO QUESTA <orgName type="institution">SCUOLA</orgName>
          <lb/>CHE CI IMPONE DI STUDIARE
          <lb/>COME SFRUTTARE GLI <rs type="social_group">OPERAI</rs>
          <lb/>IN FABBRICA, COME UCCIDERE
          <lb/><rs type="people">VIETNAMITI</rs>, COME MANIPOLARE
          <lb/>E RENDERE INNOCUI I <rs type="social_group">PROLE-
          <lb/>TARI</rs>.
        </p>

        <p rend="red bold uppercase">
          <lb/>QUESTA <orgName type="institution">SCUOLA</orgName> NON SERVE
          <lb/>A RISOLVERE I BISOGNI SOCI-
          <lb/>ALI,
          <lb/>SERVE SOLO A PERPETUA-
          <lb/>RE LO <term type="political_concept">SFRUTTAMENTO</term>
        </p>

        <p rend="red bold uppercase" scope="major">
          <lb/>QUESTA <orgName type="institution">SCUOLA</orgName>
          <lb/>NON CI SERVE
          <lb/>QUESTA <orgName type="institution">SCUOLA</orgName>
          <lb/>VA DISTRUTTA
        </p>

