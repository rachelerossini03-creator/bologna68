  <text>
    <body>
      <pb facs="DOC_016_salviamo_Panagoulis.jpg" n="1"/>

      <div type="flyer" xml:lang="it">

        <head rend="black bold uppercase" scope="major">
          <lb/>SALVIAMO
          <lb/>PANAGULIS
          <lb/>DALLA MORTE
        </head>

        <p rend="black bold">
          <lb/>I tiranni di <placeName>Atene</placeName> vogliono
          <lb/>assassinare un eroico patriota:
          <lb/><persName><forename>ALESSANDRO</forename> <surname>PANAGULIS</surname></persName>,
          <lb/>condannato a morte da una
          <lb/>corte marziale.
        </p>

        <p rend="black bold">
          <lb/>Si levi ovunque la protesta
          <lb/>dei <rs type="political_group">democratici</rs>! 
        </p>

        <p rend="black bold">
          <lb/>Basta col sangue e le torture!
        </p>

        <p rend="black bold uppercase" scope="major">
          <lb/> <term type="political_concept">LIBERTA'</term>ALLA<placeName ref="https://www.geonames.org/390903/hellenic-republic.html">GRECIA</placeName>!
        </p>

        <p rend="black" rendition="#imprint" style="font-size: xx-small; float: left;">
          <lb/><orgName type="printer">Arte Stampe - Collegio di Spagna, 17 - Bologna - 1968</orgName>
        </p>

        <p rend="black" rendition="#imprint" style="font-size: xx-small; float: right;">
          <lb/>a cura della <orgName type="association">Federazione Bolognese del P.C.I.</orgName>
        </p>

      </div>
